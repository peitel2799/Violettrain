# ============================================================
# Violette Train — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ------------------------------------------------------------
# Violet Manager API
# The Flask backend URL for the admin panel.
# Violette Manager runs on http://localhost:5173 (frontend)
# and http://localhost:5001 (API)
# ------------------------------------------------------------
VM_API_URL=http://localhost:5001/api
NEXT_PUBLIC_VM_URL=http://localhost:5173

# ------------------------------------------------------------
# Admin Authentication
# REQUIRED for accessing the /vi/admin dashboard and all
# /api/admin/* endpoints. Set a strong random string here.
# ------------------------------------------------------------
ADMIN_SECRET_TOKEN=your-super-secret-admin-token-change-this

# ------------------------------------------------------------
# Email / SMTP
# Required for sending booking confirmation emails to customers.
#
# HOW TO SET UP (Gmail):
# 1. Enable 2-Factor Authentication on your Google account
# 2. Go to myaccount.google.com/apppasswords
# 3. Generate an App Password for "Mail"
# 4. Use that 16-character password as SMTP_PASS
# 5. Use your Gmail address as SMTP_USER
#
# HOW TO SET UP (Outlook/Office 365):
# 1. Go to portal.office.com > Security > App passwords
# 2. Generate a new app password
# 3. Use smtp.office365.com as SMTP_HOST, port 587
#
# HOW TO SET UP (SendGrid — recommended for production):
# 1. Create account at sendgrid.com (free tier: 100 emails/day)
# 2. Go to Settings > API Keys > Create API Key
# 3. Use "Full Access" key as SMTP_PASS
# 4. SMTP_HOST = smtp.sendgrid.net
# 5. SMTP_USER = apikey (literal string "apikey")
#
# FOR DEVELOPMENT: Leave SMTP_HOST blank. Emails will be
# logged to the server console instead of sent.
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# The sender address shown in booking confirmation emails
EMAIL_FROM=noreply@violettetrain.vn

# Name used as the sender
EMAIL_FROM_NAME=Violette Train

# Reply-to address (shown when customer clicks Reply)
EMAIL_REPLY_TO=info@violettetrain.vn

# ------------------------------------------------------------
# Booking Settings
# ------------------------------------------------------------
NEXT_PUBLIC_BOOKING_ENABLED=true
BOOKING_MAX_PASSENGERS=6
BOOKING_MIN_ADVANCE_DAYS=1
BOOKING_MAX_ADVANCE_DAYS=90

# ------------------------------------------------------------
# Pricing
# ------------------------------------------------------------
DEFAULT_CURRENCY=VND
TAX_RATE=0.1
ROUND_TRIP_DISCOUNT=0.05
