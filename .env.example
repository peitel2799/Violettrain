# ============================================================
# Violette Train — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ------------------------------------------------------------
# Admin Authentication
# REQUIRED for accessing the /vi/admin dashboard and all
# /api/admin/* endpoints. Set a strong random string here.
# ------------------------------------------------------------
ADMIN_SECRET_TOKEN=your-super-secret-admin-token-change-this

# ------------------------------------------------------------
# Email / SMTP
# Required for sending booking confirmation emails.
#
# For Gmail: Use an App Password (enable 2FA first, then
# generate at myaccount.google.com/apppasswords)
#
# For Development: Leave SMTP_HOST blank — emails will be
# logged to the console instead of sent.
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# The sender address shown in emails
EMAIL_FROM=noreply@violettetrain.vn

# Reply-to address (shown when user clicks Reply)
EMAIL_REPLY_TO=info@violettetrain.vn

# ------------------------------------------------------------
# VNPay Payment Gateway
# Register at: https://vnpayment.vn/
# ------------------------------------------------------------
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3456/api/payments/vnpay/return
VNP_IPN_URL=http://localhost:3456/api/payments/vnpay/ipn

# ------------------------------------------------------------
# MoMo Payment Gateway
# Register at: https://business.momo.vn/
# ------------------------------------------------------------
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:3456/api/payments/momo/return
MOMO_NOTIFY_URL=http://localhost:3456/api/payments/momo/ipn

# ------------------------------------------------------------
# Booking Settings
# ------------------------------------------------------------
NEXT_PUBLIC_BOOKING_ENABLED=true
BOOKING_MAX_PASSENGERS=6
BOOKING_MIN_ADVANCE_DAYS=1
BOOKING_MAX_ADVANCE_DAYS=90

# ------------------------------------------------------------
# Pricing
# ------------------------------------------------------------
DEFAULT_CURRENCY=VND
TAX_RATE=0.1
ROUND_TRIP_DISCOUNT=0.05
