# ============================================================
# Violette Train — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ------------------------------------------------------------
# Violet Manager API
# The Flask backend URL for the admin panel.
# Violette Manager runs on http://localhost:5173 (frontend)
# and http://localhost:5001 (API)
# ------------------------------------------------------------
VM_API_URL=http://localhost:5001/api
NEXT_PUBLIC_VM_URL=http://localhost:5173

# ------------------------------------------------------------
# Supabase / Admin Authentication
# Create the first admin in Supabase Auth, then add that user's
# UUID to public.admin_profiles (see supabase/README.md).
# The anon key is safe for browser identification; RLS remains
# the authorization boundary. Never expose the service-role key.
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# DSVN timetable browser crawler. It reads the public timetable HTML page;
# it does not call the protected ticket-booking API or bypass CAPTCHA.
# Vercel cron uses UTC: 21:00 UTC is 04:00 in Asia/Ho_Chi_Minh.
DSVN_TIMETABLE_URL=https://giotaugiave.dsvn.vn/
# Optional for local/server environments with a custom Chrome installation.
DSVN_CHROME_EXECUTABLE_PATH=
DSVN_SYNC_DAYS=7
CRON_SECRET=replace-with-a-long-random-secret

# Commerce source of truth. Use "supabase" after applying all migrations.
BOOKING_DATA_SOURCE=supabase
BOOKING_HOLD_MINUTES=15

# Local payment simulator. This is ignored in production.
PAYMENT_FAKE_ENABLED=true

# How guests pay.
#   manual_paypal (default): no payment on the website. The guest leaves a
#     WhatsApp number, the cabin is held for MANUAL_PAYMENT_HOLD_HOURS and an
#     email from the company tells them how much to send by PayPal. Staff
#     confirm the money in /admin/orders ("Đã nhận tiền").
#   online: web checkout with VNPay / PayPal API (settings below).
PAYMENT_MODE=manual_paypal
MANUAL_PAYMENT_HOLD_HOURS=24
# PayPal account (email) that receives the transfers.
PAYPAL_RECEIVER_EMAIL=
# Optional PayPal.me link, e.g. https://paypal.me/violettetrain — the email adds
# the exact USD amount to it. PAYPAL_VND_PER_USD (below) sets the USD amount.
PAYPAL_ME_URL=
# Company WhatsApp shown to guests, with country code, e.g. +84915823667
COMPANY_WHATSAPP=
# Staff inbox that gets a hidden copy (BCC) of every booking email.
# Defaults to EMAIL_REPLY_TO.
BOOKING_NOTIFY_EMAIL=
# Local only: when SMTP_HOST is empty, write each email as an .html file here.
EMAIL_PREVIEW_DIR=

# VNPay Payment Gateway 2.1.0 credentials (sandbox first, then production).
# The VNPay option is shown to customers only when TMN code + secret are set.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Production: https://pay.vnpay.vn/vpcpay.html
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Set to true only after VNPay enables Visa/Mastercard/JCB on your merchant
# contract; adds an "International card" option that opens the card form directly.
VNPAY_INTERNATIONAL_CARDS=false

# PayPal Checkout (Orders v2). Shown to customers only when all three of
# client id, secret and VND rate are set. PayPal charges in USD.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# VND per 1 USD used to convert the VND order total (rounded up to the cent).
# Update it when the exchange rate moves; open checkouts keep their amount.
PAYPAL_VND_PER_USD=
# Webhook ID from the PayPal developer dashboard (for /api/payments/paypal/webhook).
PAYPAL_WEBHOOK_ID=
# Testing only: override the API host (e.g. a local mock).
PAYPAL_API_BASE=

# Legacy admin APIs only. Keep unset unless an old endpoint still
# needs to be migrated. There is no built-in fallback credential.
# Tokens shorter than 16 characters are refused; use 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SECRET_TOKEN=

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
# Public origin used in PayPal/VNPay return URLs (instead of the Host header).
# Set it in production, e.g. https://violettetrain.com
PAYMENT_RETURN_ORIGIN=
# Extra origins (comma-separated) allowed to POST to /api besides this site.
# Leave empty unless another trusted front-end must call these APIs.
ALLOWED_ORIGINS=

# ------------------------------------------------------------
# Email / SMTP
# Required for sending booking confirmation emails to customers.
#
# HOW TO SET UP (Gmail):
# 1. Enable 2-Factor Authentication on your Google account
# 2. Go to myaccount.google.com/apppasswords
# 3. Generate an App Password for "Mail"
# 4. Use that 16-character password as SMTP_PASS
# 5. Use your Gmail address as SMTP_USER
#
# HOW TO SET UP (Outlook/Office 365):
# 1. Go to portal.office.com > Security > App passwords
# 2. Generate a new app password
# 3. Use smtp.office365.com as SMTP_HOST, port 587
#
# HOW TO SET UP (SendGrid — recommended for production):
# 1. Create account at sendgrid.com (free tier: 100 emails/day)
# 2. Go to Settings > API Keys > Create API Key
# 3. Use "Full Access" key as SMTP_PASS
# 4. SMTP_HOST = smtp.sendgrid.net
# 5. SMTP_USER = apikey (literal string "apikey")
#
# FOR DEVELOPMENT: Leave SMTP_HOST blank. Emails will be
# logged to the server console instead of sent.
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# The sender address shown in booking emails. With Gmail it must be the same
# address as SMTP_USER (or an alias verified in that Gmail account).
EMAIL_FROM=noreply@violettetrain.vn

# Name used as the sender
EMAIL_FROM_NAME=Violette Train

# Reply-to address (shown when customer clicks Reply)
EMAIL_REPLY_TO=info@violettetrain.vn

# ------------------------------------------------------------
# Booking Settings
# ------------------------------------------------------------
NEXT_PUBLIC_BOOKING_ENABLED=true
BOOKING_MAX_PASSENGERS=6
BOOKING_MIN_ADVANCE_DAYS=1
BOOKING_MAX_ADVANCE_DAYS=90

# ------------------------------------------------------------
# Pricing
# ------------------------------------------------------------
DEFAULT_CURRENCY=VND
TAX_RATE=0.1
ROUND_TRIP_DISCOUNT=0.05
